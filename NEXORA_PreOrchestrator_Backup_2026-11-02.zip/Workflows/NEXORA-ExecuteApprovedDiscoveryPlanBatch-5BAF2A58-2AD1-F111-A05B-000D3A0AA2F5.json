                  "description": "The exact saved human approval request ID authorizing this plan snapshot. Approval must be recorded as APPROVED and pass validation. Do not generate an ID or submit a new approval request.",
                  "title": "ApprovalRequestID",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
