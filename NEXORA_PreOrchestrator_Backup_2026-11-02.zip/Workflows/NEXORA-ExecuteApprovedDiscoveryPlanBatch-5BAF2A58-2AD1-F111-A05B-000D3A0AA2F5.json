              },
              "actions": {
                "LookupBatchApprovalRequest": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://mnnitedu.sharepoint.com/sites/NEXORAIntelligence",
                      "table": "b5aba1ab-263a-4a28-97bb-b97e8c32525d",
                      "$filter": "ApprovalRequestID eq '@{triggerBody()?['text_2']}'",
                      "$top": 2
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "GetItems",
                      "connectionName": "shared_sharepointonline"
                    }
                  }
                },
                "LookupBatchApprovalDecision": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://mnnitedu.sharepoint.com/sites/NEXORAIntelligence",
                      "table": "dba5e7fe-f43a-411f-aefc-d45f29e2b2ea",
                      "$filter": "ApprovalRequestID eq '@{triggerBody()?['text_2']}'",
                      "$top": 2
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "GetItems",
                      "connectionName": "shared_sharepointonline"
                    }
                  },
                  "runAfter": {
                    "LookupBatchApprovalRequest": [
                      "Succeeded"
                    ]
                  }
                },
                "BatchApprovalRecordsFound": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@and(\r\n  equals(length(body('LookupBatchApprovalRequest')?['value']),1),\r\n  equals(length(body('LookupBatchApprovalDecision')?['value']),1)\r\n)",
                          "@true"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "BatchApprovalValid": {
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@and(\r\n  equals(first(body('LookupBatchApprovalRequest')?['value'])?['RequestStatus']?['Value'],'APPROVED'),\r\n  equals(first(body('LookupBatchApprovalDecision')?['value'])?['Decision']?['Value'],'APPROVED'),\r\n  equals(first(body('LookupBatchApprovalRequest')?['value'])?['ApprovalRequestID'],triggerBody()?['text_2']),\r\n  equals(first(body('LookupBatchApprovalDecision')?['value'])?['ApprovalRequestID'],triggerBody()?['text_2']),\r\n  equals(first(body('LookupBatchApprovalRequest')?['value'])?['DiscoveryRunID'],triggerBody()?['text']),\r\n  equals(first(body('LookupBatchApprovalDecision')?['value'])?['DiscoveryRunID'],triggerBody()?['text']),\r\n  equals(first(body('LookupBatchApprovalRequest')?['value'])?['PlanVersion'],triggerBody()?['text_1']),\r\n  equals(first(body('LookupBatchApprovalDecision')?['value'])?['PlanVersion'],triggerBody()?['text_1']),\r\n  not(empty(first(body('LookupBatchApprovalRequest')?['value'])?['PlanSnapshot'])),\r\n  equals(\r\n    first(body('LookupBatchApprovalRequest')?['value'])?['PlanSnapshot'],\r\n    first(body('LookupBatchApprovalDecision')?['value'])?['PlanSnapshot']\r\n  ),\r\n  not(empty(first(body('LookupBatchApprovalDecision')?['value'])?['DecisionAt'])),\r\n  not(empty(first(body('LookupBatchApprovalRequest')?['value'])?['AssignedReviewer']?['Email'])),\r\n  equals(\r\n    toLower(coalesce(first(body('LookupBatchApprovalRequest')?['value'])?['AssignedReviewer']?['Email'],'')),\r\n    toLower(coalesce(first(body('LookupBatchApprovalDecision')?['value'])?['DecisionBy']?['Email'],''))\r\n  )\r\n)",
                              "@true"
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "ReadBatchApprovalSnapshot": {
                          "type": "Compose",
                          "inputs": "@json(first(body('LookupBatchApprovalDecision')?['value'])?['PlanSnapshot'])"
                        },
                        "BatchSnapshotValid": {
                          "type": "If",
                          "expression": {
                            "and": [
                              {
                                "equals": [
                                  "@and(\r\n  equals(outputs('ReadBatchApprovalSnapshot')?['SnapshotType'],'DISCOVERY_PLAN_EXECUTION_APPROVAL'),\r\n  equals(outputs('ReadBatchApprovalSnapshot')?['SnapshotSchemaVersion'],'1.0'),\r\n  greater(length(coalesce(outputs('ReadBatchApprovalSnapshot')?['PlanItems'],json('[]'))),0),\r\n  lessOrEquals(length(coalesce(outputs('ReadBatchApprovalSnapshot')?['PlanItems'],json('[]'))),50),\r\n  equals(\r\n    outputs('ReadBatchApprovalSnapshot')?['PlanItemCount'],\r\n    length(coalesce(outputs('ReadBatchApprovalSnapshot')?['PlanItems'],json('[]')))\r\n  )\r\n)",
                                  "@true"
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "FilterInvalidBatchSnapshotItems": {
                              "type": "Query",
                              "inputs": {
                                "from": "@outputs('ReadBatchApprovalSnapshot')?['PlanItems']",
                                "where": "@equals(or(\r\n  not(equals(item()?['DiscoveryRunID'],triggerBody()?['text'])),\r\n  not(equals(item()?['PlanVersion'],triggerBody()?['text_1'])),\r\n  empty(trim(coalesce(item()?['ScopeVersion'],''))),\r\n  not(equals(item()?['ScopeVersion'],first(body('LookupBatchDiscoveryRun')?['value'])?['ScopeVersion'])),\r\n  not(equals(item()?['ProviderName'],'TAVILY_API')),\r\n  not(equals(item()?['MaxResults'],5)),\r\n  empty(trim(coalesce(item()?['PlanItemID'],''))),\r\n  empty(trim(coalesce(item()?['QueryRunID'],''))),\r\n  empty(trim(coalesce(item()?['QueryPackKey'],''))),\r\n  empty(trim(coalesce(item()?['QueryText'],'')))\r\n),true)"
                              }
                            },
                            "GetBatchPlanItems": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "dataset": "https://mnnitedu.sharepoint.com/sites/NEXORAIntelligence",
                                  "table": "2fb96fa4-a56c-458e-816c-dbc7efb8aa2b",
                                  "$filter": "@concat(\r\n  'DiscoveryRunID eq ''',\r\n  replace(triggerBody()?['text'],'''',''''''),\r\n  ''' and PlanVersion eq ''',\r\n  replace(triggerBody()?['text_1'],'''',''''''),\r\n  ''''\r\n)",
                                  "$top": 51
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "operationId": "GetItems",
                                  "connectionName": "shared_sharepointonline"
                                }
                              },
                              "runAfter": {
                                "FilterInvalidBatchSnapshotItems": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "ValidateBatchSnapshotItems": {
                              "type": "Foreach",
                              "foreach": "@outputs('ReadBatchApprovalSnapshot')?['PlanItems']",
                              "actions": {
                                "MatchCurrentBatchPlanItem": {
                                  "type": "Query",
                                  "inputs": {
                                    "from": "@body('GetBatchPlanItems')?['value']",
                                    "where": "@equals(and(\r\n  equals(item()?['PlanItemID'],items('ValidateBatchSnapshotItems')?['PlanItemID']),\r\n  equals(item()?['DiscoveryRunID'],items('ValidateBatchSnapshotItems')?['DiscoveryRunID']),\r\n  equals(item()?['PlanVersion'],items('ValidateBatchSnapshotItems')?['PlanVersion']),\r\n  equals(item()?['ScopeVersion'],items('ValidateBatchSnapshotItems')?['ScopeVersion']),\r\n  equals(item()?['QueryPackKey'],items('ValidateBatchSnapshotItems')?['QueryPackKey']),\r\n  equals(item()?['QueryText'],items('ValidateBatchSnapshotItems')?['QueryText']),\r\n  equals(item()?['QueryRunID'],items('ValidateBatchSnapshotItems')?['QueryRunID']),\r\n  equals(item()?['ProviderName'],items('ValidateBatchSnapshotItems')?['ProviderName']),\r\n  equals(item()?['MaxResults'],items('ValidateBatchSnapshotItems')?['MaxResults'])\r\n),true)"
                                  }
                                },
                                "Append_to_array_variable": {
                                  "type": "AppendToArrayVariable",
                                  "inputs": {
                                    "name": "BatchItemValidationResults",
                                    "value": "@equals(length(body('MatchCurrentBatchPlanItem')),1)"
                                  },
                                  "runAfter": {
                                    "MatchCurrentBatchPlanItem": [
                                      "Succeeded"
                                    ]
                                  }
                                }
                              },
                              "runAfter": {
                                "GetBatchPlanItems": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "SelectBatchSnapshotIdentifiers": {
                              "type": "Select",
                              "inputs": {
                                "from": "@outputs('ReadBatchApprovalSnapshot')?['PlanItems']",
                                "select": {
                                  "PlanItemID": "@item()?['PlanItemID']",
                                  "QueryRunID": "@item()?['QueryRunID']"
                                }
                              },
                              "runAfter": {
                                "ValidateBatchSnapshotItems": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "BatchPlanMatchesApproval": {
                              "type": "If",
                              "expression": {
                                "and": [
                                  {
                                    "equals": [
                                      "@and(\r\n  equals(length(body('FilterInvalidBatchSnapshotItems')),0),\r\n  equals(\r\n    length(body('GetBatchPlanItems')?['value']),\r\n    length(outputs('ReadBatchApprovalSnapshot')?['PlanItems'])\r\n  ),\r\n  equals(\r\n    length(variables('BatchItemValidationResults')),\r\n    length(outputs('ReadBatchApprovalSnapshot')?['PlanItems'])\r\n  ),\r\n  not(contains(variables('BatchItemValidationResults'),false)),\r\n  equals(\r\n    length(\r\n      union(\r\n        body('SelectBatchSnapshotIdentifiers'),\r\n        body('SelectBatchSnapshotIdentifiers')\r\n      )\r\n    ),\r\n    length(outputs('ReadBatchApprovalSnapshot')?['PlanItems'])\r\n  )\r\n)",
                                      "@true"
                                    ]
                                  }
                                ]
                              },
                              "actions": {
                                "FilterReadyBatchPlanItems": {
                                  "type": "Query",
                                  "inputs": {
                                    "from": "@body('GetBatchPlanItems')?['value']",
                                    "where": "@equals(and(\r\n  or(\r\n    equals(item()?['PlanStatus']?['Value'],'DRAFT'),\r\n    equals(item()?['PlanStatus']?['Value'],'APPROVED')\r\n  ),\r\n  empty(item()?['ExecutionStartedAt']),\r\n  empty(item()?['ExecutionCompletedAt'])\r\n),true)"
                                  }
                                },
                                "SelectOneBatchPlanItem": {
                                  "type": "Compose",
                                  "inputs": "@take(body('FilterReadyBatchPlanItems'),1)",
                                  "runAfter": {
                                    "FilterReadyBatchPlanItems": [
