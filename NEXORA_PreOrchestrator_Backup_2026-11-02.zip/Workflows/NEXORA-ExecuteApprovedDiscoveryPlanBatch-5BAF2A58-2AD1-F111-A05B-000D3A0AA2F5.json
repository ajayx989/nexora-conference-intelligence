          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "planbatchexecutionresult": {
                  "title": "PlanBatchExecutionResult",
                  "description": "",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "planbatchexecutionresult": "@{variables('PlanBatchExecutionResult')}"
            }
          },
          "runAfter": {
            "BatchDiscoveryRunFound": [
              "Succeeded",
              "TIMEDOUT",
              "SKIPPED",
              "FAILED"
            ]
          },
          "metadata": {
            "operationMetadataId": "81c94f73-dd52-465c-ad3b-a4686da63cc3"
          }
        },
        "Initialize_variable": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "PlanBatchExecutionResult",
                "type": "string",
                "value": "NOT_COMPLETED: Approved-plan batch execution has not reached a confirmed outcome. Some records may have changed if processing started. Inspect flow history and the reserved QueryRunID before retrying. No overall discovery completion is confirmed."
              }
            ]
          },
          "runAfter": {}
