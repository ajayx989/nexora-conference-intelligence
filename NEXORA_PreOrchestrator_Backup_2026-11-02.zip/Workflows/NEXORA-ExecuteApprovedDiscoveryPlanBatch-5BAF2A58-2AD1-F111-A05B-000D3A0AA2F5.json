                                    ]
                                  }
                                },
                                "ExecuteSelectedBatchItem": {
                                  "type": "Foreach",
                                  "foreach": "@outputs('SelectOneBatchPlanItem')",
                                  "actions": {
                                    "Run_a_Child_Flow": {
                                      "type": "Workflow",
                                      "inputs": {
                                        "host": {
                                          "workflowReferenceName": "ed7ff983-35d1-f111-a05b-000d3a0aa2f5"
                                        },
                                        "body": {
                                          "text": "@items('ExecuteSelectedBatchItem')?['DiscoveryRunID']",
                                          "text_1": "@items('ExecuteSelectedBatchItem')?['QueryPackKey']",
                                          "text_2": "@items('ExecuteSelectedBatchItem')?['QueryText']",
                                          "text_3": "@items('ExecuteSelectedBatchItem')?['QueryRunID']",
                                          "text_4": "@triggerBody()?['text_2']"
                                        },
                                        "retryPolicy": {
                                          "type": "none"
                                        }
                                      }
                                    },
                                    "Set_variable_6": {
                                      "type": "SetVariable",
                                      "inputs": {
                                        "name": "PlanBatchExecutionResult",
                                        "value": "@body('Run_a_Child_Flow')?['queryexecutionresult']"
                                      },
                                      "runAfter": {
                                        "Run_a_Child_Flow": [
                                          "SUCCEEDED"
                                        ]
                                      }
                                    }
                                  },
                                  "runAfter": {
                                    "Set_variable_7": [
                                      "SUCCEEDED"
                                    ]
                                  }
                                },
                                "Set_variable_7": {
                                  "type": "SetVariable",
                                  "inputs": {
                                    "name": "PlanBatchExecutionResult",
                                    "value": "NO_READY_PLAN_ITEMS: No unstarted DRAFT or APPROVED plan items were selected. No search was executed by this batch. Completed, failed, blocked, cancelled, or in-progress items were not retried. Overall discovery completion is not confirmed."
                                  },
                                  "runAfter": {
                                    "SelectOneBatchPlanItem": [
                                      "SUCCEEDED"
                                    ]
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Set_variable_5": {
                                    "type": "SetVariable",
                                    "inputs": {
                                      "name": "PlanBatchExecutionResult",
                                      "value": "BLOCKED_PLAN_CHANGED: The current plan does not match the approved snapshot, or snapshot validation found invalid or repeated items. No batch search was executed and no plan items were changed. Review the current plan, scope, and approval snapshot before proceeding."
                                    }
                                  }
                                }
                              },
                              "runAfter": {
                                "SelectBatchSnapshotIdentifiers": [
                                  "Succeeded"
                                ]
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Set_variable_4": {
                                "type": "SetVariable",
                                "inputs": {
                                  "name": "PlanBatchExecutionResult",
                                  "value": "BLOCKED_APPROVAL_SNAPSHOT: The approved snapshot has an unsupported format, an invalid item count, or no plan items. No batch search was executed and no plan items were changed. Review the saved approval snapshot before proceeding."
                                }
                              }
                            }
                          },
                          "runAfter": {
                            "ReadBatchApprovalSnapshot": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Set_variable_3": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "PlanBatchExecutionResult",
                              "value": "BLOCKED_PLAN_APPROVAL: The saved approval did not pass validation for the requested discovery run and plan version. Check approval status, matching snapshots, reviewer identity, and decision timestamp. No batch search was executed and no plan items were changed."
                            }
                          }
