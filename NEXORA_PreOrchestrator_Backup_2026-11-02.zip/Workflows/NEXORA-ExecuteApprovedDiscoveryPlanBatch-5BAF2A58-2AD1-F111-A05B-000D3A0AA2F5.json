                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Set_variable_2": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "PlanBatchExecutionResult",
                          "value": "BLOCKED_APPROVAL_LOOKUP: The supplied ApprovalRequestID did not match exactly one saved request and one recorded decision. No batch search was executed and no plan items were changed. Review missing or duplicate approval records before proceeding."
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "LookupBatchApprovalDecision": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Set_variable_1": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "PlanBatchExecutionResult",
                      "value": "BLOCKED_RUN_STATUS: The discovery run is not in RUNNING status. No batch search was executed and no plan items were changed. This tool does not change run status."
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {
              "Set_variable": {
                "type": "SetVariable",
                "inputs": {
                  "name": "PlanBatchExecutionResult",
                  "value": "@if(\r\n  equals(length(body('LookupBatchDiscoveryRun')?['value']),0),\r\n  'NOT_FOUND: No discovery run matches the supplied DiscoveryRunID. No batch search was executed and no plan items were changed.',\r\n  'DUPLICATE_DISCOVERY_RUN_ID: Multiple discovery runs match the supplied DiscoveryRunID. Resolve the duplicate records before executing a plan batch. No batch search was executed and no plan items were changed.'\r\n)"
                }
              }
            }
          },
