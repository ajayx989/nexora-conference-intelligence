              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline"
            }
          },
          "runAfter": {}
        },
        "Condition": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@length(body('Get_items')?['value'])",
                  1
                ]
              }
            ]
          },
          "actions": {
            "Set_variable": {
              "type": "SetVariable",
              "inputs": {
                "name": "RunLookupResult",
                "value": "@string(first(body('Get_items')?['value']))"
              }
            }
          },
          "else": {
            "actions": {
              "Set_variable_1": {
                "type": "SetVariable",
                "inputs": {
                  "name": "RunLookupResult",
                  "value": "@if(\r\n  equals(length(body('Get_items')?['value']), 0),\r\n  'NOT_FOUND: No discovery run matches the supplied DiscoveryRunID.',\r\n  'DUPLICATE_RUN_ID: Multiple discovery runs match the supplied DiscoveryRunID. Resolve the duplicate records before reporting status.'\r\n)"
                }
              }
            }
          },
          "runAfter": {
            "Initialize_variable": [
